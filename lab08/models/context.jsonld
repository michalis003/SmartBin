{
  "@context": {
    "@vocab": "https://schema.org/",
    "sosa": "http://www.w3.org/ns/sosa/",
    "xsd": "http://www.w3.org/2001/XMLSchema#",
    "bot": "https://w3id.org/bot#",
    
    "pipeline": "https://github.com/michalis003/SmartBin/blob/main/docs/ontology.md#",
    "project": "https://github.com/michalis003/SmartBin/blob/main/docs/ontology.md#",

    "event_time": { "@id": "sosa:resultTime", "@type": "xsd:dateTime" },
    "device_id": { "@id": "sosa:madeBySensor", "@type": "@id" },
    "event_type": "@type",
    "motion_state": { "@id": "sosa:hasSimpleResult", "@type": "xsd:string" },
    "seq": { "@id": "pipeline:sequenceNumber", "@type": "xsd:integer" },
    "run_id": { "@id": "pipeline:runId", "@type": "xsd:string" },
    "ingest_time": { "@id": "pipeline:ingestTime", "@type": "xsd:dateTime" },
    "pipeline_latency_ms": { "@id": "pipeline:latencyMs", "@type": "xsd:float" },

    "mountedOn": {"@id": "sosa:isHostedBy", "@type": "@id"},
    "deployedIn": {"@id": "schema:containedInPlace", "@type": "@id"},
    "hasSensor": {"@id": "sosa:hosts", "@type": "@id"},
    "locatedIn": {"@id": "schema:containedInPlace", "@type": "@id"},
    "contains": {"@id": "bot:containsElement", "@type": "@id"},

    "manufacturer": "schema:manufacturer",
    "model": "schema:model",
    "description": "schema:description",
    "location": "schema:location",
    "dateInstalled": "schema:dateInstalled",
    "observes": "sosa:observes",
    
    "sensingPrinciple": "project:sensingPrinciple",
    "hardwareConnection": "project:hardwareConnection",
    "dataPin": "project:dataPin",
    "operatingVoltageDC": "project:operatingVoltageDC",
    "logicLevelVoltageDC": "project:logicLevelVoltageDC",
    "detectionCharacteristics": "project:detectionCharacteristics",
    "minDetectionRangeMeters": "project:minDetectionRangeMeters",
    "maxDetectionRangeMeters": "project:maxDetectionRangeMeters",
    "detectionAngleDegrees": "project:detectionAngleDegrees",
    "delayTimeSeconds": "project:delayTimeSeconds",
    "blockTimeSeconds": "project:blockTimeSeconds",
    "triggerMode": "project:triggerMode",
    "operatingConditions": "project:operatingConditions",
    "minTemperatureCelsius": "project:minTemperatureCelsius",
    "maxTemperatureCelsius": "project:maxTemperatureCelsius",
    "environmentRating": "project:environmentRating",

    "physicalProperties": "project:physicalProperties",
    "capacityLiters": "project:capacityLiters",
    "operationalProperties": "project:operationalProperties",
    "acceptedWasteType": "project:acceptedWasteType",
    "collectionZone": "project:collectionZone",
    "status": "project:status",
    "fillLevelPercentage": "project:fillLevelPercentage",
    "isLidCurrentlyOpen": "project:isLidCurrentlyOpen",
    
    "campusManagementData": "project:campusManagementData",
    "responsibleDepartment": "project:responsibleDepartment",
    "maintenanceContact": "project:maintenanceContact",
    "powerSource": "project:powerSource",
    "ipAddress": "project:ipAddress",
    
    "wasteCollectionServiceData": "project:wasteCollectionServiceData",
    "lastCollectedDate": "project:lastCollectedDate",
    "nextScheduledCollection": "project:nextScheduledCollection",
    "requiresImmediatePickup": "project:requiresImmediatePickup",
    "estimatedWeightKg": "project:estimatedWeightKg",
    "odorAlert": "project:odorAlert",

    "zoneInformation": "project:zoneInformation",
    "trafficLevel": "project:trafficLevel",
    "pedestrianPeakHours": "project:pedestrianPeakHours",
    "accessibleToPublic": "project:accessibleToPublic",
    
    "environmentalConditions": "project:environmentalConditions",
    "environmentType": "project:environmentType",
    "isCovered": "project:isCovered",
    "climateControl": "project:climateControl",
    "averageTemperatureCelsius": "project:averageTemperatureCelsius",
    "humidityExposure": "project:humidityExposure"
  }
}